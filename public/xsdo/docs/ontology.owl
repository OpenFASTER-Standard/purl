<?xml version="1.0"?>
<rdf:RDF xmlns="https://purl.openfaster.org/xsdo/xsd-ontology.owl#"
     xml:base="https://purl.openfaster.org/xsdo/xsd-ontology.owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://purl.openfaster.org/xsdo/xsd-ontology.owl">
        <dc:description xml:lang="en">An OWL vocabulary formalizing XML Schema (XSD) 1.1&apos;s own abstract Schema Component Model (element/attribute declarations, simple/complex type definitions, particles, model groups) as graph-expressible classes and properties. Domain-agnostic: no relationship to any specific schema, module, or the Institutional Ontology&apos;s own concepts -- see the `realizations` repo for that linking layer. Ordering (xs:sequence) is expressed via an explicit xsdo:particlePosition integer property rather than rdf:List, deliberately -- see this repo&apos;s README for why.</dc:description>
        <dc:title xml:lang="en">XSD Ontology</dc:title>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://purl.openfaster.org/xsdo/attributeDeclaration -->


    <owl:ObjectProperty rdf:about="https://purl.openfaster.org/xsdo/attributeDeclaration">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/AttributeUse"/>
        <rdfs:range rdf:resource="https://purl.openfaster.org/xsdo/AttributeDeclaration"/>
        <rdfs:label xml:lang="en">attribute declaration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.openfaster.org/xsdo/baseTypeDefinition -->


    <owl:ObjectProperty rdf:about="https://purl.openfaster.org/xsdo/baseTypeDefinition">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.openfaster.org/xsdo/ComplexTypeDefinition"/>
                    <rdf:Description rdf:about="https://purl.openfaster.org/xsdo/SimpleTypeDefinition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:label xml:lang="en">base type definition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.openfaster.org/xsdo/contentModel -->


    <owl:ObjectProperty rdf:about="https://purl.openfaster.org/xsdo/contentModel">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/ComplexTypeDefinition"/>
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/ModelGroupDefinition"/>
        <rdfs:range rdf:resource="https://purl.openfaster.org/xsdo/ModelGroup"/>
        <rdfs:label xml:lang="en">content model</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.openfaster.org/xsdo/derivationMethod -->


    <owl:ObjectProperty rdf:about="https://purl.openfaster.org/xsdo/derivationMethod">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.openfaster.org/xsdo/ComplexTypeDefinition"/>
                    <rdf:Description rdf:about="https://purl.openfaster.org/xsdo/SimpleTypeDefinition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:label xml:lang="en">derivation method</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.openfaster.org/xsdo/hasAttributeUse -->


    <owl:ObjectProperty rdf:about="https://purl.openfaster.org/xsdo/hasAttributeUse">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/ComplexTypeDefinition"/>
        <rdfs:range rdf:resource="https://purl.openfaster.org/xsdo/AttributeUse"/>
        <rdfs:label xml:lang="en">has attribute use</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.openfaster.org/xsdo/hasEnumerationValue -->


    <owl:ObjectProperty rdf:about="https://purl.openfaster.org/xsdo/hasEnumerationValue">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/SimpleTypeDefinition"/>
        <rdfs:range rdf:resource="https://purl.openfaster.org/xsdo/EnumerationValue"/>
        <rdfs:label xml:lang="en">has enumeration value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.openfaster.org/xsdo/hasParticle -->


    <owl:ObjectProperty rdf:about="https://purl.openfaster.org/xsdo/hasParticle">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/ModelGroup"/>
        <rdfs:range rdf:resource="https://purl.openfaster.org/xsdo/Particle"/>
        <rdfs:label xml:lang="en">has particle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.openfaster.org/xsdo/refer -->


    <owl:ObjectProperty rdf:about="https://purl.openfaster.org/xsdo/refer">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/KeyRef"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.openfaster.org/xsdo/Key"/>
                    <rdf:Description rdf:about="https://purl.openfaster.org/xsdo/Unique"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">The Key or Unique constraint a KeyRef points to.</rdfs:comment>
        <rdfs:label xml:lang="en">refer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.openfaster.org/xsdo/term -->


    <owl:ObjectProperty rdf:about="https://purl.openfaster.org/xsdo/term">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/Particle"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.openfaster.org/xsdo/ElementDeclaration"/>
                    <rdf:Description rdf:about="https://purl.openfaster.org/xsdo/ModelGroup"/>
                    <rdf:Description rdf:about="https://purl.openfaster.org/xsdo/Wildcard"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label xml:lang="en">term</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.openfaster.org/xsdo/type -->


    <owl:ObjectProperty rdf:about="https://purl.openfaster.org/xsdo/type">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.openfaster.org/xsdo/AttributeDeclaration"/>
                    <rdf:Description rdf:about="https://purl.openfaster.org/xsdo/ElementDeclaration"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.openfaster.org/xsdo/ComplexTypeDefinition"/>
                    <rdf:Description rdf:about="https://purl.openfaster.org/xsdo/SimpleTypeDefinition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label xml:lang="en">type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://purl.openfaster.org/xsdo/enumeration -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/enumeration">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/SimpleTypeDefinition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Multi-valued: one triple per allowed value.</rdfs:comment>
        <rdfs:label xml:lang="en">enumeration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/field -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/field">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/IdentityConstraintDefinition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">XPath identifying a value contributing to an identity constraint&apos;s key. Multi-valued: one triple per field.</rdfs:comment>
        <rdfs:label xml:lang="en">field</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/fractionDigits -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/fractionDigits">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/SimpleTypeDefinition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:label xml:lang="en">fraction digits</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/literalValue -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/literalValue">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/EnumerationValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The raw XSD token this EnumerationValue represents, e.g. &quot;HERR&quot;.</rdfs:comment>
        <rdfs:label xml:lang="en">literal value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/maxExclusive -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/maxExclusive">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/SimpleTypeDefinition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">max exclusive</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/maxInclusive -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/maxInclusive">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/SimpleTypeDefinition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">max inclusive</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/maxLength -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/maxLength">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/SimpleTypeDefinition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:label xml:lang="en">max length</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/maxOccurs -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/maxOccurs">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/Particle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:label xml:lang="en">max occurs</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/maxOccursUnbounded -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/maxOccursUnbounded">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/Particle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">True if this particle&apos;s maxOccurs is XSD&apos;s &quot;unbounded&quot; -- not itself representable as an integer, hence a separate flag rather than a sentinel value on xsdo:maxOccurs.</rdfs:comment>
        <rdfs:label xml:lang="en">max occurs unbounded</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/minExclusive -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/minExclusive">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/SimpleTypeDefinition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">min exclusive</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/minInclusive -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/minInclusive">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/SimpleTypeDefinition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">min inclusive</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/minLength -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/minLength">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/SimpleTypeDefinition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:label xml:lang="en">min length</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/minOccurs -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/minOccurs">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/Particle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:label xml:lang="en">min occurs</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/name -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/name">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.openfaster.org/xsdo/AttributeDeclaration"/>
                    <rdf:Description rdf:about="https://purl.openfaster.org/xsdo/ElementDeclaration"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/particlePosition -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/particlePosition">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/Particle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="en">1-based position within an xsdo:Sequence&apos;s particles, in real document order. Meaningless outside a Sequence. Chosen over rdf:List: rdf:List has documented poor SPARQL performance at scale and no native shape-language validation -- see the design doc&apos;s Context section.</rdfs:comment>
        <rdfs:label xml:lang="en">particle position</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/pattern -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/pattern">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/SimpleTypeDefinition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">pattern</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/required -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/required">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/AttributeUse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">required</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/selector -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/selector">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/IdentityConstraintDefinition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">XPath selecting the element(s) an identity constraint applies to.</rdfs:comment>
        <rdfs:label xml:lang="en">selector</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/targetNamespace -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/targetNamespace">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label xml:lang="en">target namespace</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/test -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/test">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.openfaster.org/xsdo/Assertion"/>
                    <rdf:Description rdf:about="https://purl.openfaster.org/xsdo/TypeAlternative"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The XPath test expression for a TypeAlternative or Assertion.</rdfs:comment>
        <rdfs:label xml:lang="en">test</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/totalDigits -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/totalDigits">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/SimpleTypeDefinition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:label xml:lang="en">total digits</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/xsdo/whiteSpace -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/xsdo/whiteSpace">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/xsdo/SimpleTypeDefinition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">white space</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://purl.openfaster.org/xsdo/All -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/All">
        <rdfs:subClassOf rdf:resource="https://purl.openfaster.org/xsdo/ModelGroup"/>
        <rdfs:comment xml:lang="en">A model group whose particles may appear in any order. Corresponds to xs:all.</rdfs:comment>
        <rdfs:label xml:lang="en">All</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/Assertion -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/Assertion">
        <rdfs:comment xml:lang="en">XSD 1.1: an XPath-expressed constraint a complex type&apos;s content must satisfy. Corresponds to xs:assert.</rdfs:comment>
        <rdfs:label xml:lang="en">Assertion</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/AttributeDeclaration -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/AttributeDeclaration">
        <rdfs:comment xml:lang="en">An association between an attribute name and a simple type definition.</rdfs:comment>
        <rdfs:label xml:lang="en">Attribute Declaration</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/AttributeGroupDefinition -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/AttributeGroupDefinition">
        <rdfs:comment xml:lang="en">A named, reusable collection of attribute uses and/or a wildcard. Corresponds to xs:attributeGroup.</rdfs:comment>
        <rdfs:label xml:lang="en">Attribute Group Definition</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/AttributeUse -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/AttributeUse">
        <rdfs:comment xml:lang="en">An attribute declaration together with whether it is required/optional and its default/fixed value.</rdfs:comment>
        <rdfs:label xml:lang="en">Attribute Use</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/Choice -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/Choice">
        <rdfs:subClassOf rdf:resource="https://purl.openfaster.org/xsdo/ModelGroup"/>
        <rdfs:comment xml:lang="en">A model group of which exactly one particle may appear. Corresponds to xs:choice.</rdfs:comment>
        <rdfs:label xml:lang="en">Choice</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/ComplexTypeDefinition -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/ComplexTypeDefinition">
        <rdfs:comment xml:lang="en">Governs the allowed attributes and element/character content of an element.</rdfs:comment>
        <rdfs:label xml:lang="en">Complex Type Definition</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/ElementDeclaration -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/ElementDeclaration">
        <rdfs:comment xml:lang="en">An association between an element name and a type definition.</rdfs:comment>
        <rdfs:label xml:lang="en">Element Declaration</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/EnumerationValue -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/EnumerationValue">
        <rdfs:comment xml:lang="en">A single permitted value of a SimpleTypeDefinition&apos;s xs:enumeration facet, as a first-class node so it can carry its own realizesConcept link and be distinguished from the type&apos;s raw xsdo:enumeration string list.</rdfs:comment>
        <rdfs:label xml:lang="en">Enumeration Value</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/IdentityConstraintDefinition -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/IdentityConstraintDefinition">
        <rdfs:comment xml:lang="en">A uniqueness, key, or key-reference constraint scoped to an element. Abstract -- always one of Key, KeyRef, or Unique.</rdfs:comment>
        <rdfs:label xml:lang="en">Identity-constraint Definition</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/Key -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/Key">
        <rdfs:subClassOf rdf:resource="https://purl.openfaster.org/xsdo/IdentityConstraintDefinition"/>
        <rdfs:comment xml:lang="en">Corresponds to xs:key.</rdfs:comment>
        <rdfs:label xml:lang="en">Key</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/KeyRef -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/KeyRef">
        <rdfs:subClassOf rdf:resource="https://purl.openfaster.org/xsdo/IdentityConstraintDefinition"/>
        <rdfs:comment xml:lang="en">Corresponds to xs:keyref.</rdfs:comment>
        <rdfs:label xml:lang="en">Key Reference</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/ModelGroup -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/ModelGroup">
        <rdfs:comment xml:lang="en">A constraint on a complex type&apos;s content in terms of the particles it allows. Abstract -- always one of Sequence, Choice, or All.</rdfs:comment>
        <rdfs:label xml:lang="en">Model Group</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/ModelGroupDefinition -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/ModelGroupDefinition">
        <rdfs:comment xml:lang="en">A name bound to a model group, for reuse across content models. Corresponds to a named xs:group.</rdfs:comment>
        <rdfs:label xml:lang="en">Model Group Definition</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/NotationDeclaration -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/NotationDeclaration">
        <rdfs:comment xml:lang="en">Associates a name with an identifier for a non-XML data format. Corresponds to xs:notation.</rdfs:comment>
        <rdfs:label xml:lang="en">Notation Declaration</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/Particle -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/Particle">
        <rdfs:comment xml:lang="en">A term (element declaration, model group, or wildcard) together with occurrence constraints and, inside a Sequence, its position.</rdfs:comment>
        <rdfs:label xml:lang="en">Particle</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/Sequence -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/Sequence">
        <rdfs:subClassOf rdf:resource="https://purl.openfaster.org/xsdo/ModelGroup"/>
        <rdfs:comment xml:lang="en">A model group whose particles must appear in xsdo:particlePosition order. Corresponds to xs:sequence.</rdfs:comment>
        <rdfs:label xml:lang="en">Sequence</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/SimpleTypeDefinition -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/SimpleTypeDefinition">
        <rdfs:comment xml:lang="en">Governs the values a simple-content element or attribute may take.</rdfs:comment>
        <rdfs:label xml:lang="en">Simple Type Definition</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/TypeAlternative -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/TypeAlternative">
        <rdfs:comment xml:lang="en">XSD 1.1: a conditional type assignment based on an XPath test. Corresponds to xs:alternative.</rdfs:comment>
        <rdfs:label xml:lang="en">Type Alternative</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/Unique -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/Unique">
        <rdfs:subClassOf rdf:resource="https://purl.openfaster.org/xsdo/IdentityConstraintDefinition"/>
        <rdfs:comment xml:lang="en">Corresponds to xs:unique -- the identity-constraint kind actually used in mikadiv-vib/kafe today.</rdfs:comment>
        <rdfs:label xml:lang="en">Unique</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/xsdo/Wildcard -->


    <owl:Class rdf:about="https://purl.openfaster.org/xsdo/Wildcard">
        <rdfs:comment xml:lang="en">A constraint on element/attribute information items not covered by an explicit declaration. Corresponds to xs:any/xs:anyAttribute.</rdfs:comment>
        <rdfs:label xml:lang="en">Wildcard</rdfs:label>
    </owl:Class>
    


