}, {
  "@id" : "https://purl.openfaster.org/xsdo/xsd-ontology.owl",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/elements/1.1/description" : [ {
    "@language" : "en",
    "@value" : "An OWL vocabulary formalizing XML Schema (XSD) 1.1's own abstract Schema Component Model (element/attribute declarations, simple/complex type definitions, particles, model groups) as graph-expressible classes and properties. Domain-agnostic: no relationship to any specific schema, module, or the Institutional Ontology's own concepts -- see the `realizations` repo for that linking layer. Ordering (xs:sequence) is expressed via an explicit xsdo:particlePosition integer property rather than rdf:List, deliberately -- see this repo's README for why."
  } ],
  "http://purl.org/dc/elements/1.1/title" : [ {
    "@language" : "en",
    "@value" : "XSD Ontology"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ]
} ]