###  https://purl.openfaster.org/xsdo/attributeDeclaration
<https://purl.openfaster.org/xsdo/attributeDeclaration> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain <https://purl.openfaster.org/xsdo/AttributeUse> ;
                                                        rdfs:range <https://purl.openfaster.org/xsdo/AttributeDeclaration> ;
                                                        rdfs:label "attribute declaration"@en .


###  https://purl.openfaster.org/xsdo/baseTypeDefinition
<https://purl.openfaster.org/xsdo/baseTypeDefinition> rdf:type owl:ObjectProperty ;
                                                      rdfs:domain [ rdf:type owl:Class ;
                                                                    owl:unionOf ( <https://purl.openfaster.org/xsdo/ComplexTypeDefinition>
                                                                                  <https://purl.openfaster.org/xsdo/SimpleTypeDefinition>
                                                                                )
                                                                  ] ;
                                                      rdfs:label "base type definition"@en .


###  https://purl.openfaster.org/xsdo/contentModel
<https://purl.openfaster.org/xsdo/contentModel> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <https://purl.openfaster.org/xsdo/ComplexTypeDefinition> ,
                                                            <https://purl.openfaster.org/xsdo/ModelGroupDefinition> ;
                                                rdfs:range <https://purl.openfaster.org/xsdo/ModelGroup> ;
                                                rdfs:label "content model"@en .


###  https://purl.openfaster.org/xsdo/derivationMethod
<https://purl.openfaster.org/xsdo/derivationMethod> rdf:type owl:ObjectProperty ;
                                                    rdfs:domain [ rdf:type owl:Class ;
                                                                  owl:unionOf ( <https://purl.openfaster.org/xsdo/ComplexTypeDefinition>
                                                                                <https://purl.openfaster.org/xsdo/SimpleTypeDefinition>
                                                                              )
                                                                ] ;
                                                    rdfs:label "derivation method"@en .


###  https://purl.openfaster.org/xsdo/hasAttributeUse
<https://purl.openfaster.org/xsdo/hasAttributeUse> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <https://purl.openfaster.org/xsdo/ComplexTypeDefinition> ;
                                                   rdfs:range <https://purl.openfaster.org/xsdo/AttributeUse> ;
                                                   rdfs:label "has attribute use"@en .


###  https://purl.openfaster.org/xsdo/hasParticle
<https://purl.openfaster.org/xsdo/hasParticle> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <https://purl.openfaster.org/xsdo/ModelGroup> ;
                                               rdfs:range <https://purl.openfaster.org/xsdo/Particle> ;
                                               rdfs:label "has particle"@en .


###  https://purl.openfaster.org/xsdo/refer
<https://purl.openfaster.org/xsdo/refer> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <https://purl.openfaster.org/xsdo/KeyRef> ;
                                         rdfs:range [ rdf:type owl:Class ;
                                                      owl:unionOf ( <https://purl.openfaster.org/xsdo/Key>
                                                                    <https://purl.openfaster.org/xsdo/Unique>
                                                                  )
                                                    ] ;
                                         rdfs:comment "The Key or Unique constraint a KeyRef points to."@en ;
                                         rdfs:label "refer"@en .


###  https://purl.openfaster.org/xsdo/term
<https://purl.openfaster.org/xsdo/term> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <https://purl.openfaster.org/xsdo/Particle> ;
                                        rdfs:range [ rdf:type owl:Class ;
                                                     owl:unionOf ( <https://purl.openfaster.org/xsdo/ElementDeclaration>
                                                                   <https://purl.openfaster.org/xsdo/ModelGroup>
                                                                   <https://purl.openfaster.org/xsdo/Wildcard>
                                                                 )
                                                   ] ;
                                        rdfs:label "term"@en .


###  https://purl.openfaster.org/xsdo/type
<https://purl.openfaster.org/xsdo/type> rdf:type owl:ObjectProperty ;
                                        rdfs:domain [ rdf:type owl:Class ;
                                                      owl:unionOf ( <https://purl.openfaster.org/xsdo/AttributeDeclaration>
                                                                    <https://purl.openfaster.org/xsdo/ElementDeclaration>
                                                                  )
                                                    ] ;
                                        rdfs:range [ rdf:type owl:Class ;
                                                     owl:unionOf ( <https://purl.openfaster.org/xsdo/ComplexTypeDefinition>
                                                                   <https://purl.openfaster.org/xsdo/SimpleTypeDefinition>
                                                                 )
                                                   ] ;
                                        rdfs:label "type"@en .


