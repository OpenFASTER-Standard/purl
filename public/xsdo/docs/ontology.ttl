###  https://purl.openfaster.org/xsdo/All
<https://purl.openfaster.org/xsdo/All> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://purl.openfaster.org/xsdo/ModelGroup> ;
                                       rdfs:comment "A model group whose particles may appear in any order. Corresponds to xs:all."@en ;
                                       rdfs:label "All"@en .


###  https://purl.openfaster.org/xsdo/Assertion
<https://purl.openfaster.org/xsdo/Assertion> rdf:type owl:Class ;
                                             rdfs:comment "XSD 1.1: an XPath-expressed constraint a complex type's content must satisfy. Corresponds to xs:assert."@en ;
                                             rdfs:label "Assertion"@en .


###  https://purl.openfaster.org/xsdo/AttributeDeclaration
<https://purl.openfaster.org/xsdo/AttributeDeclaration> rdf:type owl:Class ;
                                                        rdfs:comment "An association between an attribute name and a simple type definition."@en ;
                                                        rdfs:label "Attribute Declaration"@en .


###  https://purl.openfaster.org/xsdo/AttributeGroupDefinition
<https://purl.openfaster.org/xsdo/AttributeGroupDefinition> rdf:type owl:Class ;
                                                            rdfs:comment "A named, reusable collection of attribute uses and/or a wildcard. Corresponds to xs:attributeGroup."@en ;
                                                            rdfs:label "Attribute Group Definition"@en .


###  https://purl.openfaster.org/xsdo/AttributeUse
<https://purl.openfaster.org/xsdo/AttributeUse> rdf:type owl:Class ;
                                                rdfs:comment "An attribute declaration together with whether it is required/optional and its default/fixed value."@en ;
                                                rdfs:label "Attribute Use"@en .


###  https://purl.openfaster.org/xsdo/Choice
<https://purl.openfaster.org/xsdo/Choice> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://purl.openfaster.org/xsdo/ModelGroup> ;
                                          rdfs:comment "A model group of which exactly one particle may appear. Corresponds to xs:choice."@en ;
                                          rdfs:label "Choice"@en .


###  https://purl.openfaster.org/xsdo/ComplexTypeDefinition
<https://purl.openfaster.org/xsdo/ComplexTypeDefinition> rdf:type owl:Class ;
                                                         rdfs:comment "Governs the allowed attributes and element/character content of an element."@en ;
                                                         rdfs:label "Complex Type Definition"@en .


###  https://purl.openfaster.org/xsdo/ElementDeclaration
<https://purl.openfaster.org/xsdo/ElementDeclaration> rdf:type owl:Class ;
                                                      rdfs:comment "An association between an element name and a type definition."@en ;
                                                      rdfs:label "Element Declaration"@en .


###  https://purl.openfaster.org/xsdo/IdentityConstraintDefinition
<https://purl.openfaster.org/xsdo/IdentityConstraintDefinition> rdf:type owl:Class ;
                                                                rdfs:comment "A uniqueness, key, or key-reference constraint scoped to an element. Abstract -- always one of Key, KeyRef, or Unique."@en ;
                                                                rdfs:label "Identity-constraint Definition"@en .


###  https://purl.openfaster.org/xsdo/Key
<https://purl.openfaster.org/xsdo/Key> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://purl.openfaster.org/xsdo/IdentityConstraintDefinition> ;
                                       rdfs:comment "Corresponds to xs:key."@en ;
                                       rdfs:label "Key"@en .


###  https://purl.openfaster.org/xsdo/KeyRef
<https://purl.openfaster.org/xsdo/KeyRef> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://purl.openfaster.org/xsdo/IdentityConstraintDefinition> ;
                                          rdfs:comment "Corresponds to xs:keyref."@en ;
                                          rdfs:label "Key Reference"@en .


###  https://purl.openfaster.org/xsdo/ModelGroup
<https://purl.openfaster.org/xsdo/ModelGroup> rdf:type owl:Class ;
                                              rdfs:comment "A constraint on a complex type's content in terms of the particles it allows. Abstract -- always one of Sequence, Choice, or All."@en ;
                                              rdfs:label "Model Group"@en .


###  https://purl.openfaster.org/xsdo/ModelGroupDefinition
<https://purl.openfaster.org/xsdo/ModelGroupDefinition> rdf:type owl:Class ;
                                                        rdfs:comment "A name bound to a model group, for reuse across content models. Corresponds to a named xs:group."@en ;
                                                        rdfs:label "Model Group Definition"@en .


###  https://purl.openfaster.org/xsdo/NotationDeclaration
<https://purl.openfaster.org/xsdo/NotationDeclaration> rdf:type owl:Class ;
                                                       rdfs:comment "Associates a name with an identifier for a non-XML data format. Corresponds to xs:notation."@en ;
                                                       rdfs:label "Notation Declaration"@en .


###  https://purl.openfaster.org/xsdo/Particle
<https://purl.openfaster.org/xsdo/Particle> rdf:type owl:Class ;
                                            rdfs:comment "A term (element declaration, model group, or wildcard) together with occurrence constraints and, inside a Sequence, its position."@en ;
                                            rdfs:label "Particle"@en .


###  https://purl.openfaster.org/xsdo/Sequence
<https://purl.openfaster.org/xsdo/Sequence> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://purl.openfaster.org/xsdo/ModelGroup> ;
                                            rdfs:comment "A model group whose particles must appear in xsdo:particlePosition order. Corresponds to xs:sequence."@en ;
                                            rdfs:label "Sequence"@en .


###  https://purl.openfaster.org/xsdo/SimpleTypeDefinition
<https://purl.openfaster.org/xsdo/SimpleTypeDefinition> rdf:type owl:Class ;
                                                        rdfs:comment "Governs the values a simple-content element or attribute may take."@en ;
                                                        rdfs:label "Simple Type Definition"@en .


###  https://purl.openfaster.org/xsdo/TypeAlternative
<https://purl.openfaster.org/xsdo/TypeAlternative> rdf:type owl:Class ;
                                                   rdfs:comment "XSD 1.1: a conditional type assignment based on an XPath test. Corresponds to xs:alternative."@en ;
                                                   rdfs:label "Type Alternative"@en .


###  https://purl.openfaster.org/xsdo/Unique
<https://purl.openfaster.org/xsdo/Unique> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://purl.openfaster.org/xsdo/IdentityConstraintDefinition> ;
                                          rdfs:comment "Corresponds to xs:unique -- the identity-constraint kind actually used in mikadiv-vib/kafe today."@en ;
                                          rdfs:label "Unique"@en .


###  https://purl.openfaster.org/xsdo/Wildcard
<https://purl.openfaster.org/xsdo/Wildcard> rdf:type owl:Class ;
                                            rdfs:comment "A constraint on element/attribute information items not covered by an explicit declaration. Corresponds to xs:any/xs:anyAttribute."@en ;
                                            rdfs:label "Wildcard"@en .


