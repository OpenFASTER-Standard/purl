  "http://purl.obolibrary.org/obo/IAO_0000111" : [ {
    "@language" : "en",
    "@value" : "terms merged"
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "The term has been combined with one or more other terms to create a more encompassing (merged) term."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000116" : [ {
    "@language" : "en",
    "@value" : "The deprecated term should reference the merged term with obo:IAO_0100001. The replacement term should reference the original terms as sources using obo:RO_0001000 (derives_from). An editor note should explain what were the merged terms and the reason for the merge."
  } ],
  "http://purl.org/dc/elements/1.1/contributor" : [ {
    "@id" : "https://orcid.org/0000-0001-6875-5360"
  }, {
    "@id" : "https://orcid.org/0000-0002-7356-1779"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
