}, {
  "@id" : "_:genid12",
  "@type" : [ "http://www.w3.org/2002/07/owl#Axiom" ],
  "http://purl.obolibrary.org/obo/IAO_0010000" : [ {
    "@id" : "http://purl.obolibrary.org/obo/bfo/axiom/0000006"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "per discussion with Barry Smith"
  } ],
  "http://www.w3.org/2002/07/owl#annotatedProperty" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000116"
  } ],
  "http://www.w3.org/2002/07/owl#annotatedSource" : [ {
    "@id" : "http://purl.obolibrary.org/obo/BFO_0000003"
  } ],
  "http://www.w3.org/2002/07/owl#annotatedTarget" : [ {
    "@language" : "en",
    "@value" : "Occurrent doesn't have a closure axiom because the subclasses don't necessarily exhaust all possibilites. An example would be the sum of a process and the process boundary of another process."
  } ]
}, {
  "@id" : "_:genid121",
  "@type" : [ "http://www.w3.org/2003/11/swrl#ClassAtom" ],
  "http://www.w3.org/2003/11/swrl#argument1" : [ {
    "@id" : "urn:swrl:var#d"
  } ],
  "http://www.w3.org/2003/11/swrl#classPredicate" : [ {
    "@id" : "http://purl.obolibrary.org/obo/BFO_0000034"
  } ]
}, {
  "@id" : "_:genid123",
  "@type" : [ "http://www.w3.org/2003/11/swrl#IndividualPropertyAtom" ],
  "http://www.w3.org/2003/11/swrl#argument1" : [ {
    "@id" : "urn:swrl:var#e"
  } ],
  "http://www.w3.org/2003/11/swrl#argument2" : [ {
    "@id" : "urn:swrl:var#d"
  } ],
  "http://www.w3.org/2003/11/swrl#propertyPredicate" : [ {
