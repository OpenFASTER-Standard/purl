  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "a relation between a quality and an independent continuant (the bearer), in which the quality specifically depends on the bearer for its existence"
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000116" : [ {
    "@language" : "en",
    "@value" : "A quality inheres in its bearer at all times for which the quality exists."
  } ],
