}, {
  "@id" : "https://purl.openfaster.org/io/IO_0000001",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A personal name that identifies an individual's given name(s) (first name and, where present, middle name(s)), as distinct from their family name."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000116" : [ {
    "@language" : "en",
    "@value" : "MiKaDiv XSD (ThirdPartyDisclosureRequest.xsd): FirstName EN \"The person's first name.\" / DE \"Vorname der Person.\" KaFE XSD (kafe-standardtypes.xsd, NatP_Struct): Vorname EN \"First and middle name\" / DE \"Vorname\". KaFE's Kommunikationshandbuch DIP-KAFE v1.4.0 confirms the field text explicitly covers middle names too (\"First and middle name. The length must not exceed 80 characters.\"). MiKaDiv's own handbook is silent on middle names but does not restrict the field to a single name either -- same real-world scope, hence skos:exactMatch not skos:closeMatch (see mappings/mikadiv-kafe.sssom.tsv). Confirmed to hold, verbatim, for KaFE's Ansprechperson_Struct.Vorname (contact person) too -- identical EN/DE documentation text to NatP_Struct.Vorname."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000118" : [ {
    "@language" : "de",
    "@value" : "Alle Vornamen"
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000119" : [ {
    "@language" : "en",
    "@value" : "MiKaDiv: ThirdPartyDisclosureRequest.xsd, IndividualPersonType.FirstName. KaFE: kafe-standardtypes.xsd, NatP_Struct.Vorname and Ansprechperson_Struct.Vorname. KaFE Kommunikationshandbuch DIP-KAFE v1.4.0."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "All given names"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000030"
  } ]
}, {
  "@id" : "https://purl.openfaster.org/io/IO_0000002",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A personal name that identifies an individual's family name (surname), as distinct from their given name(s)."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000116" : [ {
    "@language" : "en",
    "@value" : "MiKaDiv XSD (ThirdPartyDisclosureRequest.xsd): LastName EN \"The person's last name.\" / DE \"Nachname (Familienname) der Person.\" KaFE XSD (kafe-standardtypes.xsd, NatP_Struct): Nachname EN \"Last name\" / DE \"Nachname\". Both single-valued, no multi-value/ordering ambiguity (unlike given names) -- clean skos:exactMatch. Confirmed to hold, verbatim, for KaFE's Ansprechperson_Struct.Nachname (contact person) too -- identical EN/DE documentation text to NatP_Struct.Nachname."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000118" : [ {
    "@language" : "de",
    "@value" : "Nachname"
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000119" : [ {
    "@language" : "en",
    "@value" : "MiKaDiv: ThirdPartyDisclosureRequest.xsd, IndividualPersonType.LastName. KaFE: kafe-standardtypes.xsd, NatP_Struct.Nachname and Ansprechperson_Struct.Nachname."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Last name"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0000030"
  } ]
}, {
  "@id" : "https://purl.openfaster.org/io/institutional-ontology.owl",
