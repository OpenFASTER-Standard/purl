    "@language" : "en",
    "@value" : "A controlled vocabulary of formal/administrative (institutional, in Searle's sense) concepts, starting with German tax-reporting field alignment across the MiKaDiv and KaFE schemas."
  } ],
  "http://purl.org/dc/elements/1.1/title" : [ {
    "@language" : "en",
    "@value" : "Institutional Ontology"
  } ],
