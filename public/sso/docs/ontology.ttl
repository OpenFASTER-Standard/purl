#################################################################

###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
<http://purl.org/dc/elements/1.1/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://purl.openfaster.org/sso/hasCell
<https://purl.openfaster.org/sso/hasCell> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <https://purl.openfaster.org/sso/Sheet> ;
                                          rdfs:range <https://purl.openfaster.org/sso/Cell> ;
                                          rdfs:label "has cell"@en .


###  https://purl.openfaster.org/sso/hasSheet
<https://purl.openfaster.org/sso/hasSheet> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <https://purl.openfaster.org/sso/Workbook> ;
                                           rdfs:range <https://purl.openfaster.org/sso/Sheet> ;
                                           rdfs:label "has sheet"@en .


###  https://purl.openfaster.org/sso/headerCell
<https://purl.openfaster.org/sso/headerCell> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <https://purl.openfaster.org/sso/DataColumn> ;
                                             rdfs:range <https://purl.openfaster.org/sso/HeaderCell> ;
                                             rdfs:label "header cell"@en .


###  https://purl.openfaster.org/sso/sheet
<https://purl.openfaster.org/sso/sheet> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <https://purl.openfaster.org/sso/DataColumn> ;
                                        rdfs:range <https://purl.openfaster.org/sso/Sheet> ;
                                        rdfs:label "sheet"@en .


###  https://purl.openfaster.org/sso/valueType
<https://purl.openfaster.org/sso/valueType> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <https://purl.openfaster.org/sso/Cell> ;
                                            rdfs:label "value type"@en .


#################################################################
#    Data properties
#################################################################

###  https://purl.openfaster.org/sso/columnIndex
<https://purl.openfaster.org/sso/columnIndex> rdf:type owl:DatatypeProperty ;
                                              rdfs:domain [ rdf:type owl:Class ;
                                                            owl:unionOf ( <https://purl.openfaster.org/sso/Cell>
                                                                          <https://purl.openfaster.org/sso/DataColumn>
                                                                        )
                                                          ] ;
                                              rdfs:range xsd:positiveInteger ;
                                              rdfs:comment "1-based column position, matching Excel's own convention. Used on both Cell (its actual position) and DataColumn (a positional layout's fixed target column)."@en ;
                                              rdfs:label "column index"@en .


###  https://purl.openfaster.org/sso/dataEndRow
<https://purl.openfaster.org/sso/dataEndRow> rdf:type owl:DatatypeProperty ;
                                             rdfs:domain <https://purl.openfaster.org/sso/DataColumn> ;
                                             rdfs:range xsd:positiveInteger ;
                                             rdfs:comment "Optional. Absent means read until the first empty cell in the column."@en ;
                                             rdfs:label "data end row"@en .


###  https://purl.openfaster.org/sso/dataStartRow
<https://purl.openfaster.org/sso/dataStartRow> rdf:type owl:DatatypeProperty ;
                                               rdfs:domain <https://purl.openfaster.org/sso/DataColumn> ;
                                               rdfs:range xsd:positiveInteger ;
                                               rdfs:label "data start row"@en .


###  https://purl.openfaster.org/sso/formula
<https://purl.openfaster.org/sso/formula> rdf:type owl:DatatypeProperty ;
                                          rdfs:domain <https://purl.openfaster.org/sso/Cell> ;
                                          rdfs:range xsd:string ;
                                          rdfs:comment "Raw formula text. Only meaningful when sso:valueType is sso:formulaValue."@en ;
                                          rdfs:label "raw formula"@en .


###  https://purl.openfaster.org/sso/headerMatches
<https://purl.openfaster.org/sso/headerMatches> rdf:type owl:DatatypeProperty ;
                                                rdfs:domain <https://purl.openfaster.org/sso/DataColumn> ;
                                                rdfs:range xsd:string ;
                                                rdfs:comment "Header text to search for, used instead of a fixed sso:columnIndex when the target file's layout isn't controlled by us -- position can't be assumed, so the column is located by its header text at ingestion time instead."@en ;
                                                rdfs:label "header matches"@en .


###  https://purl.openfaster.org/sso/literalValue
<https://purl.openfaster.org/sso/literalValue> rdf:type owl:DatatypeProperty ;
                                               rdfs:domain <https://purl.openfaster.org/sso/Cell> ;
                                               rdfs:range xsd:string ;
                                               rdfs:label "literal value"@en .


###  https://purl.openfaster.org/sso/rowIndex
<https://purl.openfaster.org/sso/rowIndex> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain <https://purl.openfaster.org/sso/Cell> ;
                                           rdfs:range xsd:positiveInteger ;
                                           rdfs:comment "1-based row position, matching Excel's own convention."@en ;
                                           rdfs:label "row index"@en .


###  https://purl.openfaster.org/sso/sheetName
<https://purl.openfaster.org/sso/sheetName> rdf:type owl:DatatypeProperty ;
                                            rdfs:domain <https://purl.openfaster.org/sso/Sheet> ;
                                            rdfs:range xsd:string ;
                                            rdfs:label "sheet name"@en .


###  https://purl.openfaster.org/sso/sheetPosition
<https://purl.openfaster.org/sso/sheetPosition> rdf:type owl:DatatypeProperty ;
                                                rdfs:domain <https://purl.openfaster.org/sso/Sheet> ;
                                                rdfs:range xsd:positiveInteger ;
                                                rdfs:comment "1-based tab order within the Workbook. Explicit, like xsdo:particlePosition, for the same reason: RDF has no native ordering primitive worth trusting."@en ;
                                                rdfs:label "sheet position"@en .


#################################################################
#    Classes
#################################################################

###  https://purl.openfaster.org/sso/Cell
<https://purl.openfaster.org/sso/Cell> rdf:type owl:Class ;
                                       rdfs:comment "A single addressable cell within a Sheet. No structural role (header, data) is assumed of any Cell by default."@en ;
                                       rdfs:label "Cell"@en .


###  https://purl.openfaster.org/sso/DataColumn
<https://purl.openfaster.org/sso/DataColumn> rdf:type owl:Class ;
                                             rdfs:comment "A vertical strip of cells holding one field's worth of data. Says nothing about which field -- that link is asserted separately, outside this vocabulary, via ofr:realizesConcept."@en ;
                                             rdfs:label "Data Column"@en .


###  https://purl.openfaster.org/sso/HeaderCell
<https://purl.openfaster.org/sso/HeaderCell> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://purl.openfaster.org/sso/Cell> ;
                                             rdfs:comment "A Cell playing the header role for a DataColumn. Asserted only where a header is actually known to exist -- never assumed."@en ;
                                             rdfs:label "Header Cell"@en .


###  https://purl.openfaster.org/sso/Sheet
<https://purl.openfaster.org/sso/Sheet> rdf:type owl:Class ;
                                        rdfs:comment "One tab/page within a Workbook."@en ;
                                        rdfs:label "Sheet"@en .


###  https://purl.openfaster.org/sso/Workbook
<https://purl.openfaster.org/sso/Workbook> rdf:type owl:Class ;
                                           rdfs:comment "A single spreadsheet file, containing one or more Sheets."@en ;
                                           rdfs:label "Workbook"@en .


