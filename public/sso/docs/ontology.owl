<?xml version="1.0"?>
<rdf:RDF xmlns="https://purl.openfaster.org/sso/spreadsheet-ontology.owl#"
     xml:base="https://purl.openfaster.org/sso/spreadsheet-ontology.owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://purl.openfaster.org/sso/spreadsheet-ontology.owl">
        <dc:description xml:lang="en">An OWL vocabulary for spreadsheet structure. A raw, structure-agnostic Workbook/Sheet/Cell grid (no header or column meaning assumed) plus a separate, still domain-agnostic semantic layout layer (HeaderCell/DataColumn) for describing structure only where it is actually known. Concept-linking is not part of this vocabulary -- see the `realizations` repo&apos;s ofr:realizesConcept for that.</dc:description>
        <dc:title xml:lang="en">Spreadsheet Ontology</dc:title>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://purl.openfaster.org/sso/hasCell -->


    <owl:ObjectProperty rdf:about="https://purl.openfaster.org/sso/hasCell">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/sso/Sheet"/>
        <rdfs:range rdf:resource="https://purl.openfaster.org/sso/Cell"/>
        <rdfs:label xml:lang="en">has cell</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.openfaster.org/sso/hasSheet -->


    <owl:ObjectProperty rdf:about="https://purl.openfaster.org/sso/hasSheet">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/sso/Workbook"/>
        <rdfs:range rdf:resource="https://purl.openfaster.org/sso/Sheet"/>
        <rdfs:label xml:lang="en">has sheet</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.openfaster.org/sso/headerCell -->


    <owl:ObjectProperty rdf:about="https://purl.openfaster.org/sso/headerCell">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/sso/DataColumn"/>
        <rdfs:range rdf:resource="https://purl.openfaster.org/sso/HeaderCell"/>
        <rdfs:label xml:lang="en">header cell</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.openfaster.org/sso/sheet -->


    <owl:ObjectProperty rdf:about="https://purl.openfaster.org/sso/sheet">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/sso/DataColumn"/>
        <rdfs:range rdf:resource="https://purl.openfaster.org/sso/Sheet"/>
        <rdfs:label xml:lang="en">sheet</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.openfaster.org/sso/valueType -->


    <owl:ObjectProperty rdf:about="https://purl.openfaster.org/sso/valueType">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/sso/Cell"/>
        <rdfs:label xml:lang="en">value type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://purl.openfaster.org/sso/columnIndex -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/sso/columnIndex">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.openfaster.org/sso/Cell"/>
                    <rdf:Description rdf:about="https://purl.openfaster.org/sso/DataColumn"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="en">1-based column position, matching Excel&apos;s own convention. Used on both Cell (its actual position) and DataColumn (a positional layout&apos;s fixed target column).</rdfs:comment>
        <rdfs:label xml:lang="en">column index</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/sso/dataEndRow -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/sso/dataEndRow">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/sso/DataColumn"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="en">Optional. Absent means read until the first empty cell in the column.</rdfs:comment>
        <rdfs:label xml:lang="en">data end row</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/sso/dataStartRow -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/sso/dataStartRow">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/sso/DataColumn"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:label xml:lang="en">data start row</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/sso/formula -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/sso/formula">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/sso/Cell"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Raw formula text. Only meaningful when sso:valueType is sso:formulaValue.</rdfs:comment>
        <rdfs:label xml:lang="en">raw formula</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/sso/headerMatches -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/sso/headerMatches">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/sso/DataColumn"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Header text to search for, used instead of a fixed sso:columnIndex when the target file&apos;s layout isn&apos;t controlled by us -- position can&apos;t be assumed, so the column is located by its header text at ingestion time instead.</rdfs:comment>
        <rdfs:label xml:lang="en">header matches</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/sso/literalValue -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/sso/literalValue">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/sso/Cell"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">literal value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/sso/rowIndex -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/sso/rowIndex">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/sso/Cell"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="en">1-based row position, matching Excel&apos;s own convention.</rdfs:comment>
        <rdfs:label xml:lang="en">row index</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/sso/sheetName -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/sso/sheetName">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/sso/Sheet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">sheet name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.openfaster.org/sso/sheetPosition -->


    <owl:DatatypeProperty rdf:about="https://purl.openfaster.org/sso/sheetPosition">
        <rdfs:domain rdf:resource="https://purl.openfaster.org/sso/Sheet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:comment xml:lang="en">1-based tab order within the Workbook. Explicit, like xsdo:particlePosition, for the same reason: RDF has no native ordering primitive worth trusting.</rdfs:comment>
        <rdfs:label xml:lang="en">sheet position</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://purl.openfaster.org/sso/Cell -->


    <owl:Class rdf:about="https://purl.openfaster.org/sso/Cell">
        <rdfs:comment xml:lang="en">A single addressable cell within a Sheet. No structural role (header, data) is assumed of any Cell by default.</rdfs:comment>
        <rdfs:label xml:lang="en">Cell</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/sso/DataColumn -->


    <owl:Class rdf:about="https://purl.openfaster.org/sso/DataColumn">
        <rdfs:comment xml:lang="en">A vertical strip of cells holding one field&apos;s worth of data. Says nothing about which field -- that link is asserted separately, outside this vocabulary, via ofr:realizesConcept.</rdfs:comment>
        <rdfs:label xml:lang="en">Data Column</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/sso/HeaderCell -->


    <owl:Class rdf:about="https://purl.openfaster.org/sso/HeaderCell">
        <rdfs:subClassOf rdf:resource="https://purl.openfaster.org/sso/Cell"/>
        <rdfs:comment xml:lang="en">A Cell playing the header role for a DataColumn. Asserted only where a header is actually known to exist -- never assumed.</rdfs:comment>
        <rdfs:label xml:lang="en">Header Cell</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/sso/Sheet -->


    <owl:Class rdf:about="https://purl.openfaster.org/sso/Sheet">
        <rdfs:comment xml:lang="en">One tab/page within a Workbook.</rdfs:comment>
        <rdfs:label xml:lang="en">Sheet</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.openfaster.org/sso/Workbook -->


    <owl:Class rdf:about="https://purl.openfaster.org/sso/Workbook">
        <rdfs:comment xml:lang="en">A single spreadsheet file, containing one or more Sheets.</rdfs:comment>
        <rdfs:label xml:lang="en">Workbook</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://purl.openfaster.org/sso/booleanValue -->


    <owl:NamedIndividual rdf:about="https://purl.openfaster.org/sso/booleanValue">
        <rdfs:label xml:lang="en">boolean</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://purl.openfaster.org/sso/dateValue -->


    <owl:NamedIndividual rdf:about="https://purl.openfaster.org/sso/dateValue">
        <rdfs:label xml:lang="en">date</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://purl.openfaster.org/sso/emptyValue -->


    <owl:NamedIndividual rdf:about="https://purl.openfaster.org/sso/emptyValue">
        <rdfs:label xml:lang="en">empty</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://purl.openfaster.org/sso/formulaValue -->


    <owl:NamedIndividual rdf:about="https://purl.openfaster.org/sso/formulaValue">
        <rdfs:label xml:lang="en">formula</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://purl.openfaster.org/sso/numberValue -->


    <owl:NamedIndividual rdf:about="https://purl.openfaster.org/sso/numberValue">
        <rdfs:label xml:lang="en">number</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://purl.openfaster.org/sso/stringValue -->


    <owl:NamedIndividual rdf:about="https://purl.openfaster.org/sso/stringValue">
        <rdfs:label xml:lang="en">string</rdfs:label>
    </owl:NamedIndividual>
</rdf:RDF>



